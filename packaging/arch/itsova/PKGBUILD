# Maintainer: m00sfett <https://github.com/m00sfett>
# Beta release template. After the tag exists, replace the checksum with the verified SHA-256.
# Do not publish or use this package until the source archive and installation are verified.
pkgname=itsova
pkgver=0.12.0_beta.1
_tag=v0.12.0-beta.1
pkgrel=1
pkgdesc='Screenshot tool for KDE Plasma: fixed areas, monitors and windows on global shortcuts'
arch=('x86_64')
url='https://github.com/m00sfett/Itsova'
license=('AGPL-3.0-or-later')
conflicts=('glimply' 'glimply-git')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'kconfig' 'kdbusaddons' 'kglobalaccel' 'ki18n'
         'ffmpeg' 'knotifications' 'kpipewire' 'kstatusnotifieritem' 'layer-shell-qt' 'kwidgetsaddons' 'kwin' 'kxmlgui'
         'qt6-base' 'qt6-wayland' 'wayland')
makedepends=('cmake' 'ninja' 'plasma-wayland-protocols' 'qt6-tools')
checkdepends=('python' 'qt6-imageformats')
optdepends=('tesseract: text recognition (Copy Text, itsova capture --ocr)'
            'tesseract-data-eng: English text recognition'
            'qt6-imageformats: WebP and additional export image formats'
            'plasma-workspace: the Itsova Plasma widget')
source=("$pkgname-$_tag.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
# Placeholder intentionally fails verification until the published archive is checked.
sha256sums=('REPLACE_WITH_VERIFIED_SHA256')

build() {
  cmake -B build -S "Itsova-${_tag#v}" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure -LE nested
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
