# Maintainer: m00sfett <https://github.com/m00sfett>
# Release package, used from 1.0.0 on: there are no release tags before that.
pkgname=glimply
pkgver=1.0.0
pkgrel=1
pkgdesc='Screenshot tool for KDE Plasma: fixed areas, monitors and windows on global shortcuts'
arch=('x86_64')
url='https://github.com/m00sfett/glimply'
license=('AGPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'kconfig' 'kdbusaddons' 'kglobalaccel' 'ki18n'
         'ffmpeg' 'knotifications' 'kpipewire' 'kstatusnotifieritem' 'layer-shell-qt' 'kwidgetsaddons' 'kwin' 'kxmlgui'
         'qt6-base' 'qt6-wayland' 'wayland')
makedepends=('cmake' 'ninja' 'plasma-wayland-protocols' 'qt6-tools')
checkdepends=('python' 'qt6-imageformats')
optdepends=('tesseract: text recognition (Copy Text, glimply capture --ocr)'
            'tesseract-data-eng: English text recognition'
            'qt6-imageformats: WebP and additional export image formats'
            'plasma-workspace: the glimply Plasma widget')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Fill in with updpkgsums once the v$pkgver tag exists.
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
