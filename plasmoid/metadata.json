        "Authors": [
            {
                "Name": "glimply contributors"
            }
        ],
        "Category": "Utilities",
        "Description": "Capture fixed screen areas and monitors, and manage them",
        "EnabledByDefault": true,
        "Icon": "io.github.m00sfett.glimply",
