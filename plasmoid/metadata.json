        "License": "AGPL-3.0-or-later",
        "Name": "glimply",
        "Version": "@GLIMPLY_VERSION@",
        "Description[de]": "Feste Bildschirmbereiche und Bildschirme aufnehmen und verwalten"
    },
    "X-Plasma-API-Minimum-Version": "6.0",
