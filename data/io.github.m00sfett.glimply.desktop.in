[Desktop Entry]
Type=Application
Name=glimply
GenericName=Fixed Region Screenshots
GenericName[ja]=固定範囲のスクリーンショット
GenericName[fr]=Captures d'écran de zones fixes
GenericName[de]=Bildschirmfotos fester Bereiche
Comment=Capture fixed screen regions and monitors with global shortcuts
Comment[ja]=グローバルショートカットで固定の画面範囲とディスプレイをキャプチャします
Comment[fr]=Capturer des zones fixes de l'écran et des écrans avec des raccourcis globaux
Comment[de]=Feste Bildschirmbereiche und Bildschirme mit globalen Tastenkürzeln aufnehmen
Exec=@GLIMPLY_EXEC@
Icon=io.github.m00sfett.glimply
Categories=Utility;Graphics;
Keywords=screenshot;capture;region;monitor;
Keywords[ja]=screenshot;capture;region;monitor;スクリーンショット;キャプチャ;範囲;ディスプレイ;画面;
Keywords[fr]=screenshot;capture;capture d'écran;zone;région;écran;moniteur;
Keywords[de]=screenshot;capture;region;monitor;Bildschirmfoto;Aufnahme;Bereich;Bildschirm;
StartupNotify=false
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
